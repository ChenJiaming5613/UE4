#include "Common.ush"
#include "/Engine/Private/SHCommon.ush" 
#include "/Engine/Private/VolumetricLightmapShared.ush"
#include "/Engine/Generated/Material.ush"
#include "/Engine/Generated/VertexFactory.ush"

#define MAX_DIM 64
#define INPUT_DIM 3
#define OUTPUT_DIM 3

#define MIDDLE_LAYER_COUNT 5

#define SIREN_W0 30.0

float3 RunVoxelMLP(float3 InPos, StructuredBuffer<float> Weights)
{
    uint Offset = 0;
    
    float LayerIn[MAX_DIM]; 
    float TempOut[MAX_DIM];

    // ====================================================
    // 1. Input(3) -> Hidden(64) + Activation Func
    // ====================================================
    {
        int InDim = INPUT_DIM;   // 3
        int OutDim = MAX_DIM;    // 64
        
        uint BiasOffsetBase = Offset + (OutDim * InDim);

        for (int o = 0; o < OutDim; o++)
        {
            float Sum = Weights[BiasOffsetBase + o];

            uint WIdx = Offset + (o * InDim);
            
            Sum += InPos.x * Weights[WIdx + 0];
            Sum += InPos.y * Weights[WIdx + 1];
            Sum += InPos.z * Weights[WIdx + 2];

            // Activation Func
            // LayerIn[o] = max(0.0f, Sum); // ReLU
        	LayerIn[o] = sin(Sum * SIREN_W0); // SIREN
        }

        Offset += (OutDim * InDim) + OutDim;
    }

    // ====================================================
    // 2. Hidden(64) -> Hidden(64) + Activation Func
    // ====================================================
    for (int L = 0; L < MIDDLE_LAYER_COUNT; L++)
    {
        int Dim = MAX_DIM; // 64
        uint BiasOffsetBase = Offset + (Dim * Dim);

        for (int o = 0; o < Dim; o++)
        {
            float Sum = Weights[BiasOffsetBase + o];
            
            uint WStartIdx = Offset + (o * Dim);

            for (int i = 0; i < Dim; i++)
            {
                Sum += LayerIn[i] * Weights[WStartIdx + i];
            }

        	// Activation Func
        	// TempOut[o] = max(0.0f, Sum); // ReLU
        	TempOut[o] = sin(Sum * SIREN_W0); // SIREN
        }

        for (int k = 0; k < Dim; k++)
        {
            LayerIn[k] = TempOut[k];
        }

        Offset += (Dim * Dim) + Dim;
    }

    // ====================================================
    // 3. Hidden(64) -> Output(3) (Linear / No Activation)
    // ====================================================
    float3 Result;
    {
        int InDim = MAX_DIM;     // 64
        int OutDim = OUTPUT_DIM; // 3
        
        uint BiasOffsetBase = Offset + (OutDim * InDim);

        for (int o = 0; o < OutDim; o++)
        {
            float Sum = Weights[BiasOffsetBase + o];
            uint WStartIdx = Offset + (o * InDim);

            for (int i = 0; i < InDim; i++)
            {
                Sum += LayerIn[i] * Weights[WStartIdx + i];
            }

            Result[o] = Sum; 
        }
    }

    return Result;
}

struct FCustomMeshPassVSToPS
{
	FVertexFactoryInterpolantsVSToPS Interpolants;
	float4 Position : SV_POSITION;
};

void MainVS(FVertexFactoryInput Input, out FCustomMeshPassVSToPS Output)
{
	ResolvedView = ResolveView();
	FVertexFactoryIntermediates VFIntermediates = GetVertexFactoryIntermediates(Input);
	float4 WorldPos = VertexFactoryGetWorldPosition(Input, VFIntermediates);
	Output.Position = INVARIANT(mul(WorldPos, ResolvedView.TranslatedWorldToClip));
	
	// setup normal tangent
	float3x3 TangentToLocal = VertexFactoryGetTangentToLocal(Input, VFIntermediates);
	FMaterialVertexParameters VertexParameters = GetMaterialVertexParameters(Input, VFIntermediates, WorldPos.xyz, TangentToLocal);
	
	// output factor interpolants
	Output.Interpolants = VertexFactoryGetInterpolantsVSToPS(Input, VFIntermediates, VertexParameters);
}
 
void MainPS(FCustomMeshPassVSToPS Input, out float4 OutColor : SV_Target0)
{
	ResolvedView = ResolveView();
	FMaterialPixelParameters MaterialParameters = GetMaterialPixelParameters(Input.Interpolants, Input.Position);
	FPixelMaterialInputs PixelMaterialInputs;
	CalcMaterialParameters(MaterialParameters, PixelMaterialInputs, Input.Position, true);

	FOneBandSHVectorRGB IrradianceSH;
	FOneBandSHVector DiffuseTransferSH = CalcDiffuseTransferSH1(1);

	if (View.VolumetricLightmapMLPInfoVector.x == 1)
	{
		float3 IndirectionVolumeUVs = clamp(MaterialParameters.AbsoluteWorldPosition * View.VolumetricLightmapWorldToUVScale + View.VolumetricLightmapWorldToUVAdd, 0.0f, .99f);
		float3 RGB = RunVoxelMLP(IndirectionVolumeUVs, View.VolumetricLightmapMLPBuffer);
		IrradianceSH.R.V = RGB.x;
		IrradianceSH.G.V = RGB.y;
		IrradianceSH.B.V = RGB.z;
		OutColor.rgb = max(float3(0, 0, 0), DotSH1(IrradianceSH, DiffuseTransferSH)) / PI;
		OutColor.a = 1;
	}
	else if (View.VolumetricLightmapMLPInfoVector.x == 2)
	{
		float3 IndirectionVolumeUVs = clamp(MaterialParameters.AbsoluteWorldPosition * View.VolumetricLightmapWorldToUVScale + View.VolumetricLightmapWorldToUVAdd, 0.0f, .99f);
		float3 RGB = Texture3DSampleLevel(View.VolumetricLightmapMLPTexture, PIVSharedAmbientSampler, IndirectionVolumeUVs, 0).xyz;
		IrradianceSH.R.V = RGB.x;
		IrradianceSH.G.V = RGB.y;
		IrradianceSH.B.V = RGB.z;
		OutColor.rgb = max(float3(0, 0, 0), DotSH1(IrradianceSH, DiffuseTransferSH)) / PI;
		OutColor.a = 1;
	}
	else
	{
		float3 VolumetricLightmapBrickTextureUVs = ComputeVolumetricLightmapBrickTextureUVs(MaterialParameters.AbsoluteWorldPosition);
		IrradianceSH = GetVolumetricLightmapSH1(VolumetricLightmapBrickTextureUVs);
		OutColor.rgb = max(float3(0, 0, 0), DotSH1(IrradianceSH, DiffuseTransferSH)) / PI;
		OutColor.a = 1;
	}
}
